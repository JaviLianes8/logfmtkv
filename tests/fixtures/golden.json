{
 "sources": {
  "go-logfmt": "github.com/go-logfmt/logfmt, decode_test.go and encode_test.go (MIT License)",
  "heroku": "brandur.org/logfmt, the logfmt article describing Heroku's log format",
  "loki": "Grafana Loki docs, docs/sources/query/log_queries/_index.md, logfmt parser",
  "logrus": "github.com/sirupsen/logrus, README.md text formatter output (MIT License)",
  "slog": "Go standard library log/slog, doc.go, example_test.go, handler_test.go (BSD-3)"
},
 "notes": [
  "Short excerpts used as test vectors; each case names its source.",
  "go-logfmt reports nil for both 'k=' and a bare 'k'; logfmtkv reports '' and None.",
  "Error positions are 1-based characters; go_pos is go-logfmt's byte position.",
  "Invalid UTF-8 input bytes appear here as U+FFFD, as a UTF-8 decoder yields them."
],
 "parse": [
  {"source": "go-logfmt", "line": "x= ", "pairs": [["x", ""]], "strict": "same"},
  {"source": "go-logfmt", "line": "y=", "pairs": [["y", ""]], "strict": "same"},
  {"source": "go-logfmt", "line": "y", "pairs": [["y", null]], "strict": "same"},
  {"source": "go-logfmt", "line": "y=f", "pairs": [["y", "f"]], "strict": "same"},
  {"source": "go-logfmt", "line": "y=\"\\tf\"", "pairs": [["y", "\tf"]], "strict": "same"},
  {"source": "go-logfmt", "line": "a=1\n", "pairs": [["a", "1"]], "strict": "same"},
  {"source": "go-logfmt", "line": "a=1 b=\"bar\" \u0192=2h3s r=\"esc\\t\" d x=sf   ", "pairs": [["a", "1"], ["b", "bar"], ["\u0192", "2h3s"], ["r", "esc\t"], ["d", null], ["x", "sf"]], "strict": "same"},
  {"source": "go-logfmt", "line": "y= d y=g", "pairs": [["y", ""], ["d", null], ["y", "g"]], "strict": "same"},
  {"source": "go-logfmt", "line": "y=\"f\\n\"y=g", "pairs": [["y", "f\n"], ["y", "g"]], "strict": "same"},
  {"source": "go-logfmt", "line": "y=f y=f y=f y=f y=f ", "pairs": [["y", "f"], ["y", "f"], ["y", "f"], ["y", "f"], ["y", "f"]], "strict": "same"},
  {"source": "heroku", "line": "at=info method=GET path=/ host=mutelight.org fwd=\"124.133.52.161\" dyno=web.2 connect=4ms service=8ms status=200 bytes=1653", "pairs": [["at", "info"], ["method", "GET"], ["path", "/"], ["host", "mutelight.org"], ["fwd", "124.133.52.161"], ["dyno", "web.2"], ["connect", "4ms"], ["service", "8ms"], ["status", "200"], ["bytes", "1653"]], "strict": "same"},
  {"source": "heroku", "line": "level=info tag=stopping_fetchers id=ConsumerFetcherManager-1382721708341 module=kafka.consumer.ConsumerFetcherManager", "pairs": [["level", "info"], ["tag", "stopping_fetchers"], ["id", "ConsumerFetcherManager-1382721708341"], ["module", "kafka.consumer.ConsumerFetcherManager"]], "strict": "same"},
  {"source": "heroku", "line": "level=info msg=\"Stopping all fetchers\" tag=stopping_fetchers id=ConsumerFetcherManager-1382721708341 module=kafka.consumer.ConsumerFetcherManager", "pairs": [["level", "info"], ["msg", "Stopping all fetchers"], ["tag", "stopping_fetchers"], ["id", "ConsumerFetcherManager-1382721708341"], ["module", "kafka.consumer.ConsumerFetcherManager"]], "strict": "same"},
  {"source": "heroku", "line": "msg=\"Request finished\" tag=request_finish status=200 user=brandur@mutelight.org user_id=1234 app=mutelight app_id=1234", "pairs": [["msg", "Request finished"], ["tag", "request_finish"], ["status", "200"], ["user", "brandur@mutelight.org"], ["user_id", "1234"], ["app", "mutelight"], ["app_id", "1234"]], "strict": "same"},
  {"source": "heroku", "line": "msg=\"Request errored\" tag=request_error error_class=NoMethodError error_message=\"undefined method `serialize' for nil:NilClass\" user=brandur@mutelight.org user_id=1234 app=mutelight app_id=1234", "pairs": [["msg", "Request errored"], ["tag", "request_error"], ["error_class", "NoMethodError"], ["error_message", "undefined method `serialize' for nil:NilClass"], ["user", "brandur@mutelight.org"], ["user_id", "1234"], ["app", "mutelight"], ["app_id", "1234"]], "strict": "same"},
  {"source": "loki", "line": "at=info method=GET path=/ host=grafana.net fwd=\"124.133.124.161\" service=8ms status=200", "pairs": [["at", "info"], ["method", "GET"], ["path", "/"], ["host", "grafana.net"], ["fwd", "124.133.124.161"], ["service", "8ms"], ["status", "200"]], "strict": "same"},
  {"source": "loki", "line": "key=value key=\"value in double quotes\"", "pairs": [["key", "value"], ["key", "value in double quotes"]], "strict": "same"},
  {"source": "loki", "line": "=value", "pairs": [], "strict": {"msg": "unexpected '='", "pos": 1}},
  {"source": "loki", "line": "foo=bar=buzz", "pairs": [["foo", "bar=buzz"]], "strict": {"msg": "unexpected '='", "pos": 8}},
  {"source": "loki", "line": "fo\"o=bar", "pairs": [["fo\"o", "bar"]], "strict": {"msg": "unexpected '\"'", "pos": 3}},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=debug msg=\"Started observing beach\" animal=walrus number=8", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "debug"], ["msg", "Started observing beach"], ["animal", "walrus"], ["number", "8"]], "strict": "same"},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=info msg=\"A group of walrus emerges from the ocean\" animal=walrus size=10", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "info"], ["msg", "A group of walrus emerges from the ocean"], ["animal", "walrus"], ["size", "10"]], "strict": "same"},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=warning msg=\"The group's number increased tremendously!\" number=122 omg=true", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "warning"], ["msg", "The group's number increased tremendously!"], ["number", "122"], ["omg", "true"]], "strict": "same"},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=debug msg=\"Temperature changes\" temperature=-4", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "debug"], ["msg", "Temperature changes"], ["temperature", "-4"]], "strict": "same"},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=fatal msg=\"The ice breaks!\" animal=orca err=\"It's over 9000!\" number=100 omg=true size=9009", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "fatal"], ["msg", "The ice breaks!"], ["animal", "orca"], ["err", "It's over 9000!"], ["number", "100"], ["omg", "true"], ["size", "9009"]], "strict": "same"},
  {"source": "logrus", "line": "time=\"2015-03-26T01:27:38-04:00\" level=fatal method=github.com/sirupsen/arcticcreatures.migrate msg=\"a penguin swims by\" animal=penguin", "pairs": [["time", "2015-03-26T01:27:38-04:00"], ["level", "fatal"], ["method", "github.com/sirupsen/arcticcreatures.migrate"], ["msg", "a penguin swims by"], ["animal", "penguin"]], "strict": "same"},
  {"source": "slog", "line": "time=2022-11-08T15:28:26.000-05:00 level=INFO msg=hello count=3", "pairs": [["time", "2022-11-08T15:28:26.000-05:00"], ["level", "INFO"], ["msg", "hello"], ["count", "3"]], "strict": "same"},
  {"source": "slog", "line": "level=INFO msg=finished req.method=GET req.url=localhost status=200 duration=1s", "pairs": [["level", "INFO"], ["msg", "finished"], ["req.method", "GET"], ["req.url", "localhost"], ["status", "200"], ["duration", "1s"]], "strict": "same"},
  {"source": "slog", "line": "msg=message a=1 g.b=2 g.h.c=3 g.d=4 e=5", "pairs": [["msg", "message"], ["a", "1"], ["g.b", "2"], ["g.h.c", "3"], ["g.d", "4"], ["e", "5"]], "strict": "same"},
  {"source": "slog", "line": "time=2000-01-02T03:04:05.000Z level=INFO msg=message a=one b=2 \"\"=v", "pairs": [["time", "2000-01-02T03:04:05.000Z"], ["level", "INFO"], ["msg", "message"], ["a", "one"], ["b", "2"]], "strict": {"msg": "unexpected '\"'", "pos": 64}},
  {"source": "slog", "line": "msg=message \"a b\"=\"x\\t\\n\\x00y\" \" b.c=\\\"\\\\x2E\\t.d=e\"=\"f.g\\\"\" \" b.c=\\\"\\\\x2E\\t.m.d\"=1", "pairs": [["msg", "message"], ["a b", "x\t\n\u0000y"], [" b.c=\"\\x2E\t.d=e", "f.g\""], [" b.c=\"\\x2E\t.m.d", "1"]], "strict": {"msg": "unexpected '\"'", "pos": 13}},
  {"source": "slog", "line": "msg=message bs=\"\\x01\\x02\\x03\\x04\"", "pairs": [["msg", "message"], ["bs", "\u0001\u0002\u0003\u0004"]], "strict": {"msg": "invalid quoted value", "pos": 34}}
 ],
 "strict_errors": [
  {"source": "go-logfmt", "text": "a=1\n=bar", "lineno": 2, "msg": "unexpected '='", "pos": 1, "go_pos": 1, "lenient_pairs": []},
  {"source": "go-logfmt", "text": "a=1\n\"k\"=bar", "lineno": 2, "msg": "unexpected '\"'", "pos": 1, "go_pos": 1, "lenient_pairs": [["k", "bar"]]},
  {"source": "go-logfmt", "text": "a=1\nk\"ey=bar", "lineno": 2, "msg": "unexpected '\"'", "pos": 2, "go_pos": 2, "lenient_pairs": [["k\"ey", "bar"]]},
  {"source": "go-logfmt", "text": "a=1\nk=b\"ar", "lineno": 2, "msg": "unexpected '\"'", "pos": 4, "go_pos": 4, "lenient_pairs": [["k", "b\"ar"]]},
  {"source": "go-logfmt", "text": "a=1\nk=b =ar", "lineno": 2, "msg": "unexpected '='", "pos": 5, "go_pos": 5, "lenient_pairs": [["k", "b"]]},
  {"source": "go-logfmt", "text": "a==", "lineno": 1, "msg": "unexpected '='", "pos": 3, "go_pos": 3, "lenient_pairs": [["a", "="]]},
  {"source": "go-logfmt", "text": "a=1\nk=b=ar", "lineno": 2, "msg": "unexpected '='", "pos": 4, "go_pos": 4, "lenient_pairs": [["k", "b=ar"]]},
  {"source": "go-logfmt", "text": "a=\"1", "lineno": 1, "msg": "unterminated quoted value", "pos": 5, "go_pos": 5, "lenient_pairs": [["a", "1"]]},
  {"source": "go-logfmt", "text": "a=\"1\\", "lineno": 1, "msg": "unterminated quoted value", "pos": 6, "go_pos": 6, "lenient_pairs": [["a", "1\\"]]},
  {"source": "go-logfmt", "text": "a=\"\\t1", "lineno": 1, "msg": "unterminated quoted value", "pos": 7, "go_pos": 7, "lenient_pairs": [["a", "\t1"]]},
  {"source": "go-logfmt", "text": "a=\"\\u1\"", "lineno": 1, "msg": "invalid quoted value", "pos": 8, "go_pos": 8, "lenient_pairs": [["a", "\\u1"]]},
  {"source": "go-logfmt", "text": "a\ufffd=bar", "lineno": 1, "msg": "invalid key", "pos": 3, "go_pos": 5, "lenient_pairs": [["a\ufffd", "bar"]]},
  {"source": "go-logfmt", "text": "\ufffd=bar", "lineno": 1, "msg": "invalid key", "pos": 2, "go_pos": 2, "lenient_pairs": [["\ufffd", "bar"]]},
  {"source": "go-logfmt", "text": "\ufffd", "lineno": 1, "msg": "invalid key", "pos": 2, "go_pos": 2, "lenient_pairs": [["\ufffd", null]]}
 ],
 "streams": [
  {"source": "go-logfmt", "text": "", "records": []},
  {"source": "go-logfmt", "text": "\n\n", "records": [[], []]},
  {"source": "go-logfmt", "text": "y=f\ny=g", "records": [[["y", "f"]], [["y", "g"]]]},
  {"source": "go-logfmt", "text": "y=f  \n\u001e y=g", "records": [[["y", "f"]], [["y", "g"]]]},
  {"source": "go-logfmt", "text": "y=\"f\"\ny=g", "records": [[["y", "f"]], [["y", "g"]]]},
  {"source": "go-logfmt", "text": "a=1\nb=2\n", "records": [[["a", "1"]], [["b", "2"]]]}
 ],
 "canonical": [
  {"source": "go-logfmt", "line": "a=1 b=\"bar\" \u0192=2h3s r=\"esc\\t\" d x=sf   ", "want": "a=1 b=bar \u0192=2h3s r=\"esc\\t\" d x=sf", "go_want": "a=1 b=bar \u0192=2h3s r=\"esc\\t\" d= x=sf"},
  {"source": "go-logfmt", "line": "a=1", "want": "a=1", "go_want": "a=1"}
 ],
 "encode": [
  {"source": "go-logfmt", "key": "k", "value": "v", "want": "k=v"},
  {"source": "go-logfmt", "key": "\\", "value": "v", "want": "\\=v"},
  {"source": "go-logfmt", "key": "k", "value": "", "want": "k="},
  {"source": "go-logfmt", "key": "k", "value": "null", "want": "k=\"null\""},
  {"source": "go-logfmt", "key": "k", "value": "<nil>", "want": "k=<nil>"},
  {"source": "go-logfmt", "key": "k", "value": 1, "want": "k=1"},
  {"source": "go-logfmt", "key": "k", "value": 1.025, "want": "k=1.025"},
  {"source": "go-logfmt", "key": "k", "value": 0.001, "want": "k=0.001"},
  {"source": "go-logfmt", "key": "k", "value": "v v", "want": "k=\"v v\""},
  {"source": "go-logfmt", "key": "k", "value": " ", "want": "k=\" \""},
  {"source": "go-logfmt", "key": "k", "value": "\"", "want": "k=\"\\\"\""},
  {"source": "go-logfmt", "key": "k", "value": "=", "want": "k=\"=\""},
  {"source": "go-logfmt", "key": "k", "value": "\\", "want": "k=\\"},
  {"source": "go-logfmt", "key": "k", "value": "=\\", "want": "k=\"=\\\\\""},
  {"source": "go-logfmt", "key": "k", "value": "\\\"", "want": "k=\"\\\\\\\"\""},
  {"source": "go-logfmt", "key": "k", "value": "\ufffd\u0000", "want": "k=\"\\ufffd\\u0000\""},
  {"source": "go-logfmt", "key": "k", "value": "\ufffd", "want": "k=\"\\ufffd\""},
  {"source": "go-logfmt", "key": "k", "value": "\u007f", "want": "k=\"\\u007f\""},
  {"source": "go-logfmt", "key": "k\u007f", "value": "v", "want": "k=v"}
 ]
}
